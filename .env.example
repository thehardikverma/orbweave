# Environment variables for the Orbweave website
# Copy this file to .env.local for local development (`vercel dev`),
# or add the same keys in your Vercel project settings.

# Resend API key for the contact form (https://resend.com/api-keys)
RESEND_API_KEY=

# Sender and recipient for contact form emails.
# The sender must use a domain you have verified in Resend.
CONTACT_FROM_EMAIL="Orbweave <hello@your-domain.com>"
CONTACT_TO_EMAIL=you@your-domain.com
# Optional: time zone used in the submission timestamp (IANA name)
CONTACT_TIMEZONE=UTC

# Groq API key for the AI chat widget (https://console.groq.com/keys)
GROQ_API_KEY=
